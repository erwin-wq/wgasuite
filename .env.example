APP_NAME=WGASuite API
ENVIRONMENT=development

# Required: replace these placeholders before starting Docker Compose.
POSTGRES_DB=dread
POSTGRES_USER=dread
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password

BACKEND_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Required: replace with a long, random value used only for this environment.
AUTH_SECRET_KEY=replace-with-a-long-random-signing-key
AUTH_TOKEN_EXPIRES_MINUTES=480

# Required for the local development login. Choose your own password.
DEVELOPMENT_ADMIN_EMAIL=admin@example.local
DEVELOPMENT_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password

GOOGLE_WORKSPACE_CONNECTOR_ENABLED=false
